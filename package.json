{
  "name": "brauser",
  "private": true,
  "version": "0.0.0",
  "description": "Development tooling for the Brauser browser extension and shared protocol",
  "scripts": {
    "build:extension": "node extension/build.mjs",
    "test:extension": "node --test extension/tests/worker.test.mjs extension/tests/options.test.mjs extension/tests/note-editor.test.mjs extension/tests/agent.test.mjs",
    "smoke:macos": "node scripts/smoke-macos.mjs",
    "smoke:macos:headless": "node scripts/smoke-macos.mjs --headless",
    "probe:m15a": "node scripts/probe-m15a.mjs",
    "check:macos-alert": "node scripts/check-macos-alert.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
