{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rausified/rauser-browser/blob/main/protocol/schema.json",
  "title": "Brauser native messaging protocol",
  "description": "Version 4 messages exchanged by the Chrome extension and native host. Host-owned configuration and consent tokens gate capture and writes.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "Request": {
      "oneOf": [
        {
          "$ref": "#/$defs/HelloRequest"
        },
        {
          "$ref": "#/$defs/GetConfigRequest"
        },
        {
          "$ref": "#/$defs/UpdateConfigRequest"
        },
        {
          "$ref": "#/$defs/ChooseFolderRequest"
        },
        {
          "$ref": "#/$defs/ConfirmConfigRequest"
        },
        {
          "$ref": "#/$defs/RecordVisitRequest"
        },
        {
          "$ref": "#/$defs/LoadNoteRequest"
        },
        {
          "$ref": "#/$defs/SaveNoteRequest"
        },
        {
          "$ref": "#/$defs/CheckAgentRequest"
        },
        {
          "$ref": "#/$defs/DiscoverHarnessesRequest"
        },
        {
          "$ref": "#/$defs/ConfirmHarnessSetupRequest"
        }
      ]
    },
    "Response": {
      "oneOf": [
        {
          "$ref": "#/$defs/HelloResult"
        },
        {
          "$ref": "#/$defs/ConfigResult"
        },
        {
          "$ref": "#/$defs/ConfigUpdated"
        },
        {
          "$ref": "#/$defs/FolderChosen"
        },
        {
          "$ref": "#/$defs/ConfigConfirmed"
        },
        {
          "$ref": "#/$defs/VisitRecorded"
        },
        {
          "$ref": "#/$defs/NoteLoaded"
        },
        {
          "$ref": "#/$defs/NoteSaved"
        },
        {
          "$ref": "#/$defs/NoteConflict"
        },
        {
          "$ref": "#/$defs/AgentChecked"
        },
        {
          "$ref": "#/$defs/HarnessesDiscovered"
        },
        {
          "$ref": "#/$defs/HarnessSetupConfirmed"
        },
        {
          "$ref": "#/$defs/ErrorResponse"
        }
      ]
    },
    "HelloRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "GetConfigRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id"
      ],
      "properties": {
        "type": {
          "const": "get_config"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "UpdateConfigRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "expected_revision",
        "config",
        "picker_token",
        "consent_token",
        "harness_token"
      ],
      "properties": {
        "type": {
          "const": "update_config"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config": {
          "$ref": "#/$defs/ConfigSnapshot"
        },
        "picker_token": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "consent_token": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "harness_token": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HelloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "host_version",
        "configured",
        "config_issue"
      ],
      "properties": {
        "type": {
          "const": "hello_result"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "host_version": {
          "type": "string"
        },
        "configured": {
          "type": "boolean"
        },
        "config_issue": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ConfigResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "revision",
        "config",
        "config_issue",
        "agent_status"
      ],
      "properties": {
        "type": {
          "const": "config_result"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config": {
          "$ref": "#/$defs/ConfigSnapshot"
        },
        "config_issue": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_status": {
          "$ref": "#/$defs/AgentStatus"
        }
      }
    },
    "ConfigUpdated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "revision",
        "config"
      ],
      "properties": {
        "type": {
          "const": "config_updated"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config": {
          "$ref": "#/$defs/ConfigSnapshot"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "An empty request_id is allowed only when the host could not recover an ID from a malformed request.",
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "maxLength": 128
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unsupported_protocol_version",
        "invalid_config",
        "not_configured",
        "unauthorized",
        "conflict",
        "message_too_large",
        "internal",
        "cancelled"
      ]
    },
    "ConfigSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "capture_enabled",
        "sites",
        "strip_params",
        "near_repeat_secs",
        "agent_denylist",
        "agent_denylist_confirmed",
        "log_incognito",
        "agent"
      ],
      "properties": {
        "storage": {
          "oneOf": [
            {
              "$ref": "#/$defs/StorageConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture_enabled": {
          "type": "boolean"
        },
        "sites": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/SiteConfig"
          }
        },
        "strip_params": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "near_repeat_secs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "agent_denylist": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "agent_denylist_confirmed": {
          "type": "boolean",
          "description": "Set only by the host through native harness setup; update_config accepts it unchanged."
        },
        "log_incognito": {
          "type": "boolean",
          "const": false
        },
        "agent": {
          "oneOf": [
            {
              "$ref": "#/$defs/AgentConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "StorageConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "profile",
        "log_dir",
        "pages_dir",
        "later_dir",
        "summaries_dir"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "log_dir": {
          "type": "string",
          "minLength": 1
        },
        "pages_dir": {
          "type": "string",
          "minLength": 1
        },
        "later_dir": {
          "type": "string",
          "minLength": 1
        },
        "summaries_dir": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "A confirmed harness entry. Only native harness setup can create or change it.",
      "required": [
        "harness_id",
        "adapter",
        "binary",
        "args",
        "env_allow",
        "timeout_secs"
      ],
      "properties": {
        "harness_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "adapter": {
          "$ref": "#/$defs/HarnessAdapter"
        },
        "binary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "env_allow": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "HarnessAdapter": {
      "type": "string",
      "enum": [
        "claude_code",
        "codex"
      ]
    },
    "AgentStatus": {
      "type": "object",
      "additionalProperties": false,
      "description": "Host-derived AI readiness. Reported in config_result only; never accepted from the extension.",
      "required": [
        "state",
        "harness_version",
        "message"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/AgentState"
        },
        "harness_version": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AgentState": {
      "type": "string",
      "enum": [
        "not_set_up",
        "denylist_unconfirmed",
        "harness_problem",
        "ready"
      ]
    },
    "ChooseFolderRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id"
      ],
      "properties": {
        "type": {
          "const": "choose_folder"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ConfirmConfigRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "expected_revision",
        "config",
        "picker_token"
      ],
      "properties": {
        "type": {
          "const": "confirm_config"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config": {
          "$ref": "#/$defs/ConfigSnapshot"
        },
        "picker_token": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RecordVisitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "event"
      ],
      "properties": {
        "type": {
          "const": "record_visit"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event": {
          "$ref": "#/$defs/VisitEvent"
        }
      }
    },
    "LoadNoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "url"
      ],
      "properties": {
        "type": {
          "const": "load_note"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "SaveNoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "url",
        "title",
        "body",
        "expected_revision"
      ],
      "properties": {
        "type": {
          "const": "save_note"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "maxLength": 98304
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "CheckAgentRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ask whether AI commands may run, and optionally whether a page URL passes the agent denylist.",
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "url"
      ],
      "properties": {
        "type": {
          "const": "check_agent"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "FolderChosen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "path",
        "picker_token"
      ],
      "properties": {
        "type": {
          "const": "folder_chosen"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "picker_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ConfigConfirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "consent_token",
        "summary"
      ],
      "properties": {
        "type": {
          "const": "config_confirmed"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "consent_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "VisitRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "event_id",
        "outcome",
        "reason",
        "relative_path"
      ],
      "properties": {
        "type": {
          "const": "visit_recorded"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outcome": {
          "$ref": "#/$defs/VisitOutcome"
        },
        "reason": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relative_path": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NoteLoaded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "exists",
        "revision",
        "title",
        "body"
      ],
      "properties": {
        "type": {
          "const": "note_loaded"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "exists": {
          "type": "boolean"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 2048
        },
        "body": {
          "type": "string",
          "maxLength": 98304
        }
      }
    },
    "NoteSaved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "outcome",
        "revision",
        "relative_path"
      ],
      "properties": {
        "type": {
          "const": "note_saved"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outcome": {
          "$ref": "#/$defs/NoteSaveOutcome"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "NoteConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "exists",
        "revision",
        "title",
        "body"
      ],
      "properties": {
        "type": {
          "const": "note_conflict"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "exists": {
          "type": "boolean"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 2048
        },
        "body": {
          "type": "string",
          "maxLength": 98304
        }
      }
    },
    "AgentChecked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "harness_id",
        "harness_version",
        "url_allowed"
      ],
      "properties": {
        "type": {
          "const": "agent_checked"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "harness_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "harness_version": {
          "type": "string",
          "maxLength": 256
        },
        "url_allowed": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SiteConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "path_prefix"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "path_prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "VisitEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "url",
        "title",
        "occurred_at",
        "incognito"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "title": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 25
        },
        "incognito": {
          "type": "boolean"
        }
      }
    },
    "VisitOutcome": {
      "type": "string",
      "enum": [
        "persisted",
        "suppressed",
        "rejected",
        "retryable"
      ]
    },
    "NoteSaveOutcome": {
      "type": "string",
      "enum": [
        "created",
        "replaced",
        "created_with_warning",
        "replaced_with_warning"
      ]
    },
    "DiscoverHarnessesRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ask the host to look for supported AI harnesses on its own search path. The extension never supplies a binary path.",
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "expected_revision"
      ],
      "properties": {
        "type": {
          "const": "discover_harnesses"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ConfirmHarnessSetupRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ask the host to show its own confirmation dialog for one discovered harness offer, then run one test prompt.",
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "expected_revision",
        "offer_id",
        "env_names",
        "agent_denylist",
        "summaries_dir"
      ],
      "properties": {
        "type": {
          "const": "confirm_harness_setup"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "offer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "env_names": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "agent_denylist": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "summaries_dir": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HarnessesDiscovered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "offers"
      ],
      "properties": {
        "type": {
          "const": "harnesses_discovered"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "offers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/HarnessOffer"
          }
        }
      }
    },
    "HarnessSetupConfirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "harness_token",
        "config",
        "summary"
      ],
      "properties": {
        "type": {
          "const": "harness_setup_confirmed"
        },
        "protocol_version": {
          "type": "integer",
          "const": 4
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "harness_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config": {
          "$ref": "#/$defs/ConfigSnapshot"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "HarnessOffer": {
      "type": "object",
      "additionalProperties": false,
      "description": "One harness the host found. offer_id is null exactly when refusal explains why it cannot be set up. Help and command output are never included.",
      "required": [
        "offer_id",
        "adapter",
        "harness_id",
        "binary",
        "real_path",
        "version",
        "args",
        "env_required",
        "env_optional",
        "refusal"
      ],
      "properties": {
        "offer_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter": {
          "$ref": "#/$defs/HarnessAdapter"
        },
        "harness_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "binary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "real_path": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "env_required": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "env_optional": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/EnvName"
          }
        },
        "refusal": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "EnvName": {
      "type": "object",
      "additionalProperties": false,
      "description": "An environment variable name the harness may need. Values are never sent.",
      "required": [
        "name",
        "present"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "present": {
          "type": "boolean"
        }
      }
    }
  }
}
